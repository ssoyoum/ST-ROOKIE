{
  "name": "st-rookie",
  "version": "1.0.0",
  "description": "포스코 공개 자료 기반 제선 공정 질문형 교육 MVP",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run start",
    "build": "tsc --noEmit false --outDir .build",
    "start": "npm run build && node --env-file-if-exists=.env .build/backend/src/ironmaking-server.js",
    "start:ollama": "npm run build && node --env-file-if-exists=.env scripts/start-ollama.mjs",
    "start:gemini": "npm run build && node --env-file-if-exists=.env scripts/start-gemini.mjs",
    "chat:ollama": "npm run build && node --env-file-if-exists=.env .build/llm/eval/ask-ollama.js",
    "eval:ollama": "npm run build && node --env-file-if-exists=.env .build/llm/eval/run-ollama.js",
    "test:ollama-checkpoint": "npm run build && node --env-file-if-exists=.env .build/llm/eval/run-ollama.js --mode checkpoint",
    "warm:ollama": "npm run build && node --env-file-if-exists=.env .build/llm/eval/warm-ollama.js",
    "profile:ollama": "npm run build && node --env-file-if-exists=.env .build/llm/eval/profile-ollama.js",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-demo-layout.mjs",
    "check:exam-retry": "node scripts/check-exam-retry-live.mjs",
    "test": "npm run build && node --test .build/backend/test/*.test.js",
    "eval:evaluator": "npm run build && node --env-file-if-exists=.env .build/llm/eval/run-evaluator.js",
    "eval:export-human": "npm run build && node .build/llm/eval/export-human.js",
    "eval:questions": "npm run build && node --env-file-if-exists=.env .build/llm/eval/sample-questions.js",
    "eval:learning": "npm run build && node --env-file-if-exists=.env .build/llm/eval/run-learning.js",
    "eval:retrieval": "npm run build && node .build/llm/eval/run-retrieval.js",
    "finetune:prepare": "npm run build && node .build/llm/finetune/prepare.js",
    "verify:private": "node scripts/verify-private-cutover.mjs",
    "eval:supplement": "npm run build && node --env-file-if-exists=.env .build/llm/eval/run-supplement.js",
    "tunnel": "node --env-file-if-exists=.env scripts/tunnel.mjs",
    "db:reset-user": "npm run build && node --env-file-if-exists=.env .build/backend/src/db/reset-user.js",
    "db:seed-demo": "npm run build && node --env-file-if-exists=.env .build/backend/src/db/seed-demo-records.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/won2912/ST-ROOKIE.git"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
